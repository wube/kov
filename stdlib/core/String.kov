// Kov standard library: String. A growable sequence of UTF-8 code units, always zero-terminated
// so that c_str() is free. One plain class: no character traits, no allocator parameter.
//
struct String
{
  char* data = nullptr; // nullptr while empty
  int length = 0;
  int capacity = 0;

  String() {}
  implicit String(const char* text) { this->append(text); }
  String(const String& other) { this->append(other.data, other.length); }
  ~String()
  {
    if (this->data)
      free(this->data);
  }

  String& operator=(const String& other)
  {
    if (this == &other)
      return *this;
    this->length = 0;
    this->append(other.data, other.length);
    if (this->data)
      this->data[this->length] = 0;
    return *this;
  }

  static const int npos = -1;

  int size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  const char* c_str() const { return this->data ? this->data : ""; }
  char operator[](int index) const { return this->data[index]; }
  char& operator[](int index) { return this->data[index]; }
  char* begin() { return this->data; }
  char* end() { return this->data + this->length; }
  char back() const { return this->data[this->length - 1]; }
  char front() const { return this->data[0]; }

  void push_back(char c) { this->append(c); }
  void pop_back()
  {
    if (this->length > 0)
      this->data[--this->length] = 0;
  }
  void resize(int newLength, char fill)
  {
    if (newLength < this->length)
    {
      this->length = newLength;
      this->data[this->length] = 0;
      return;
    }
    this->reserve(newLength);
    while (this->length < newLength)
      this->data[this->length++] = fill;
    this->data[this->length] = 0;
  }
  void resize(int newLength) { this->resize(newLength, 0); }
  // Removes count bytes at index (to the end when count is negative).
  void erase(int index, int count)
  {
    if (index < 0 || index >= this->length)
      return;
    if (count < 0 || index + count > this->length)
      count = this->length - index;
    memmove(this->data + index, this->data + index + count, this->length - index - count + 1);
    this->length -= count;
  }
  void erase(int index) { this->erase(index, -1); }
  void insert(int index, const char* text, int count)
  {
    if (index > this->length)
      index = this->length;
    this->reserve(this->length + count);
    memmove(this->data + index + count, this->data + index, this->length - index + 1);
    memcpy(this->data + index, text, count);
    this->length += count;
  }
  void insert(int index, const char* text) { this->insert(index, text, (int)strlen(text)); }
  void insert(int index, const String& text) { this->insert(index, text.data, text.length); }
  // Replaces count bytes at index with text.
  void replace(int index, int count, const char* text)
  {
    this->erase(index, count);
    this->insert(index, text);
  }
  void replace(int index, int count, const String& text)
  {
    this->erase(index, count);
    this->insert(index, text);
  }
  int find(const char* needle, int from) const
  {
    int n = (int)strlen(needle);
    for (int i = from; i + n <= this->length; ++i)
      if (memcmp(this->data + i, needle, n) == 0)
        return i;
    return -1;
  }
  int find(const char* needle) const { return this->find(needle, 0); }
  int find(const String& needle) const { return this->find(needle.c_str(), 0); }
  int find(const String& needle, int from) const { return this->find(needle.c_str(), from); }
  int find(char c, int from) const
  {
    for (int i = from; i < this->length; ++i)
      if (this->data[i] == c)
        return i;
    return -1;
  }
  int rfind(char c) const
  {
    for (int i = this->length; i-- > 0;)
      if (this->data[i] == c)
        return i;
    return -1;
  }
  static bool oneOf(char c, const char* set)
  {
    for (int i = 0; set[i] != 0; ++i)
      if (set[i] == c)
        return true;
    return false;
  }
  int find_first_of(char c) const { return this->find(c); }
  int find_first_of(const String& set) const { return this->find_first_of(set.c_str()); }
  int find_first_not_of(const String& set) const { return this->find_first_not_of(set.c_str()); }
  int find_last_not_of(const String& set) const { return this->find_last_not_of(set.c_str()); }
  int find_first_of(const char* set) const
  {
    for (int i = 0; i < this->length; ++i)
      if (String::oneOf(this->data[i], set))
        return i;
    return -1;
  }
  int find_first_not_of(const char* set) const
  {
    for (int i = 0; i < this->length; ++i)
      if (!String::oneOf(this->data[i], set))
        return i;
    return -1;
  }
  int find_last_not_of(const char* set) const
  {
    for (int i = this->length; i-- > 0;)
      if (!String::oneOf(this->data[i], set))
        return i;
    return -1;
  }
  bool endsWith(const String& suffix) const
  {
    return suffix.length <= this->length && memcmp(this->data + this->length - suffix.length, suffix.data, suffix.length) == 0;
  }
  bool operator==(const char* other) const { return strlen(other) == (size_t)this->length && memcmp(this->c_str(), other, this->length) == 0; }
  bool operator!=(const char* other) const { return !(*this == other); }
  bool operator<(const String& other) const
  {
    int common = this->length < other.length ? this->length : other.length;
    int c = common == 0 ? 0 : memcmp(this->data, other.data, common);
    return c != 0 ? c < 0 : this->length < other.length;
  }
  String& operator+=(const char* text)
  {
    this->append(text);
    return *this;
  }

  void reserve(int needed)
  {
    if (needed + 1 <= this->capacity)
      return;
    int newCapacity = this->capacity == 0 ? 16 : this->capacity;
    while (newCapacity < needed + 1)
      newCapacity *= 2;
    char* bigger = (char*)malloc(newCapacity);
    if (this->data)
    {
      memcpy(bigger, this->data, this->length + 1);
      free(this->data);
    }
    else
      bigger[0] = 0;
    this->data = bigger;
    this->capacity = newCapacity;
  }

  void append(const char* bytes, int count)
  {
    if (count <= 0)
      return;
    this->reserve(this->length + count);
    memcpy(this->data + this->length, bytes, count);
    this->length += count;
    this->data[this->length] = 0;
  }
  void append(const char* text) { this->append(text, (int)strlen(text)); }
  void append(const String& other) { this->append(other.data, other.length); }
  void append(char c)
  {
    this->reserve(this->length + 1);
    this->data[this->length] = c;
    ++this->length;
    this->data[this->length] = 0;
  }

  String& operator+=(const String& other)
  {
    this->append(other);
    return *this;
  }
  String& operator+=(char c)
  {
    this->append(c);
    return *this;
  }
  String operator+(const String& other) const
  {
    String result(*this);
    result += other;
    return result;
  }

  bool operator==(const String& other) const
  {
    if (this->length != other.length)
      return false;
    return memcmp(this->c_str(), other.c_str(), this->length) == 0;
  }
  bool operator!=(const String& other) const { return !(*this == other); }

  int find(char c) const
  {
    for (int i = 0; i < this->length; ++i)
      if (this->data[i] == c)
        return i;
    return -1;
  }
  bool startsWith(const String& prefix) const
  {
    if (prefix.length > this->length)
      return false;
    return memcmp(this->c_str(), prefix.c_str(), prefix.length) == 0;
  }
  String substr(int start, int count) const
  {
    String result;
    if (start < this->length)
    {
      int available = this->length - start;
      result.append(this->data + start, count < available ? count : available);
    }
    return result;
  }
  void clear()
  {
    this->length = 0;
    if (this->data)
      this->data[0] = 0;
  }
};

String operator+(const char* left, const String& right)
{
  String result(left);
  result.append(right);
  return result;
}
