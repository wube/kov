// Kov standard library: the small utilities everything uses.

template<typename T>
T&& move(T& value) { return (T&&)value; }

template<typename T>
T&& forward(T& value) { return (T&&)value; }

template<typename T>
void swap(T& a, T& b)
{
  T tmp = move(a);
  a = move(b);
  b = move(tmp);
}

// Stores newValue and returns what was there.
template<typename T, typename U>
T exchange(T& slot, const U& newValue)
{
  T old = move(slot);
  slot = newValue;
  return old;
}

// The bits of one value read as another type of the same size (`bitCast<uint32_t>(f)`).
template<typename To, typename From>
To bitCast(const From& from) { return *(const To*)&from; }

template<typename T>
const T& min(const T& a, const T& b) { return b < a ? b : a; }
template<typename T>
const T& max(const T& a, const T& b) { return a < b ? b : a; }
template<typename T>
const T& clamp(const T& value, const T& low, const T& high) { return value < low ? low : high < value ? high : value; }

// Two values together: the result of split functions, entries of maps.
template<typename A, typename B>
struct Pair
{
  A first;
  B second;

  Pair() {}
  Pair(const A& first, const B& second) : first(first), second(second) {}

  bool operator==(const Pair<A, B>& other) const { return this->first == other.first && this->second == other.second; }
  bool operator!=(const Pair<A, B>& other) const { return !(*this == other); }
  bool operator<(const Pair<A, B>& other) const
  {
    if (this->first < other.first)
      return true;
    if (other.first < this->first)
      return false;
    return this->second < other.second;
  }
};

template<typename A, typename B>
Pair<A, B> makePair(const A& first, const B& second) { return Pair<A, B>(first, second); }

// Up to four values together (what std::tuple converts to); `get<I>(tuple)` reads one.
struct Nothing {};
template<typename A, typename B = Nothing, typename C = Nothing, typename D = Nothing>
struct Tuple
{
  A first;
  B second;
  C third;
  D fourth;

  Tuple() {}
  Tuple(const A& first, const B& second) : first(first), second(second) {}
  Tuple(const A& first, const B& second, const C& third) : first(first), second(second), third(third) {}
  Tuple(const A& first, const B& second, const C& third, const D& fourth) : first(first), second(second), third(third), fourth(fourth) {}
};
template<typename A, typename B>
Tuple<A, B> makeTuple(const A& a, const B& b) { return Tuple<A, B>(a, b); }
template<typename A, typename B, typename C>
Tuple<A, B, C> makeTuple(const A& a, const B& b, const C& c) { return Tuple<A, B, C>(a, b, c); }
template<typename A, typename B, typename C, typename D>
Tuple<A, B, C, D> makeTuple(const A& a, const B& b, const C& c, const D& d) { return Tuple<A, B, C, D>(a, b, c, d); }

// The type of element I of a Tuple, and the element itself.
template<int I, typename A, typename B, typename C, typename D>
struct TupleElement {};
template<typename A, typename B, typename C, typename D>
struct TupleElement<0, A, B, C, D> { using Type = A; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<1, A, B, C, D> { using Type = B; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<2, A, B, C, D> { using Type = C; };
template<typename A, typename B, typename C, typename D>
struct TupleElement<3, A, B, C, D> { using Type = D; };
template<int I>
struct TupleGet {};
template<>
struct TupleGet<0> { template<typename A, typename B, typename C, typename D> static A& of(Tuple<A, B, C, D>& t) { return t.first; } };
template<>
struct TupleGet<1> { template<typename A, typename B, typename C, typename D> static B& of(Tuple<A, B, C, D>& t) { return t.second; } };
template<>
struct TupleGet<2> { template<typename A, typename B, typename C, typename D> static C& of(Tuple<A, B, C, D>& t) { return t.third; } };
template<>
struct TupleGet<3> { template<typename A, typename B, typename C, typename D> static D& of(Tuple<A, B, C, D>& t) { return t.fourth; } };
template<int I, typename A, typename B, typename C, typename D>
typename TupleElement<I, A, B, C, D>::Type& get(Tuple<A, B, C, D>& t) { return TupleGet<I>::of(t); }
template<int I, typename A, typename B, typename C, typename D>
const typename TupleElement<I, A, B, C, D>::Type& get(const Tuple<A, B, C, D>& t) { return TupleGet<I>::of(const_cast<Tuple<A, B, C, D>&>(t)); }

// The result of a three-way comparison `a <=> b` (what std::strong_ordering, weak_ordering and
// partial_ordering convert to): less, equal or greater, compared with the literal 0 as in C++
// (`(a <=> b) < 0`). A defaulted `operator<=>` orders by the bases and members in turn, and gives
// the class `==` as well; `a != b` is `!(a == b)` and `a < b` is `(a <=> b) < 0` for every class.
struct strong_ordering
{
  int8_t value;
  constexpr strong_ordering(int8_t value) : value(value) {}
  static inline const strong_ordering less = strong_ordering(-1);
  static inline const strong_ordering equal = strong_ordering(0);
  static inline const strong_ordering equivalent = strong_ordering(0);
  static inline const strong_ordering greater = strong_ordering(1);
  constexpr bool operator==(const strong_ordering& other) const { return this->value == other.value; }
  constexpr bool operator==(int zero) const { return this->value == zero; }
  constexpr bool operator<(int zero) const { return this->value < zero; }
  constexpr bool operator>(int zero) const { return this->value > zero; }
  constexpr bool operator<=(int zero) const { return this->value <= zero; }
  constexpr bool operator>=(int zero) const { return this->value >= zero; }
};
using weak_ordering = strong_ordering;
using partial_ordering = strong_ordering;

// The range and special values of the arithmetic types.
template<typename T>
struct Limits
{
};

template<>
struct Limits<int8_t>
{
  static int8_t min() { return (int8_t)-128; }
  static int8_t max() { return 127; }
  static int8_t lowest() { return (int8_t)-128; }
};
template<>
struct Limits<uint8_t>
{
  static uint8_t min() { return 0; }
  static uint8_t max() { return 255; }
  static uint8_t lowest() { return 0; }
};
template<>
struct Limits<int16_t>
{
  static int16_t min() { return (int16_t)-32768; }
  static int16_t max() { return 32767; }
  static int16_t lowest() { return (int16_t)-32768; }
};
template<>
struct Limits<uint16_t>
{
  static uint16_t min() { return 0; }
  static uint16_t max() { return 65535; }
  static uint16_t lowest() { return 0; }
};
template<>
struct Limits<int>
{
  static int min() { return -2147483647 - 1; }
  static int max() { return 2147483647; }
  static int lowest() { return -2147483647 - 1; }
};
template<>
struct Limits<unsigned int>
{
  static unsigned int min() { return 0; }
  static unsigned int max() { return 4294967295u; }
  static unsigned int lowest() { return 0; }
};
template<>
struct Limits<long long>
{
  static long long min() { return -9223372036854775807ll - 1; }
  static long long max() { return 9223372036854775807ll; }
  static long long lowest() { return -9223372036854775807ll - 1; }
};
template<>
struct Limits<unsigned long long>
{
  static unsigned long long min() { return 0; }
  static unsigned long long max() { return 18446744073709551615ull; }
  static unsigned long long lowest() { return 0; }
};
template<>
struct Limits<float>
{
  static float min() { return 1.17549435e-38f; }
  static float max() { return 3.40282347e+38f; }
  static float lowest() { return -3.40282347e+38f; }
  static float infinity() { return 1e38f * 1e38f; }
  static float quiet_NaN() { return 0.0f / 0.0f; }
  static float epsilon() { return 1.19209290e-07f; }
};
template<>
struct Limits<double>
{
  static double min() { return 2.2250738585072014e-308; }
  static double max() { return 1.7976931348623157e+308; }
  static double lowest() { return -1.7976931348623157e+308; }
  static double infinity() { return 1e308 * 1e308; }
  static double quiet_NaN() { return 0.0 / 0.0; }
  static double epsilon() { return 2.2204460492503131e-16; }
};

// Errors carried by exceptions: a message and nothing else.
struct Exception
{
  String message;
  Exception() {}
  explicit Exception(const String& message) : message(message) {}
  const char* what() const { return this->message.c_str(); }
};
struct RuntimeError : Exception
{
  RuntimeError() {}
  explicit RuntimeError(const String& message) : Exception(message) {}
};
struct LogicError : Exception
{
  LogicError() {}
  explicit LogicError(const String& message) : Exception(message) {}
};
struct OutOfRange : LogicError
{
  OutOfRange() {}
  explicit OutOfRange(const String& message) : LogicError(message) {}
};
struct InvalidArgument : LogicError
{
  InvalidArgument() {}
  explicit InvalidArgument(const String& message) : LogicError(message) {}
};
