// Kov standard library: the small containers. Set<T> and Map<K, V> keep their entries sorted in
// a Vector and find them by binary search; Deque<T> is a Vector that also pops at the front. All
// three are the simplest thing that has the interface; they get real implementations when a
// program needs them to be fast.

// A fixed-size array that knows its size (what std::array converts to).
template<typename T, int N>
struct Array
{
  T items[N];

  using iterator = T*;
  using const_iterator = const T*;
  using value_type = T;

  int size() const { return N; }
  bool empty() const { return N == 0; }
  T& operator[](int index) { return this->items[index]; }
  const T& operator[](int index) const { return this->items[index]; }
  T& at(int index) { return this->items[index]; }
  const T& at(int index) const { return this->items[index]; }
  T* data() { return this->items; }
  const T* data() const { return this->items; }
  T* begin() { return this->items; }
  T* end() { return this->items + N; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + N; }
  T& front() { return this->items[0]; }
  T& back() { return this->items[N - 1]; }
  void fill(const T& value)
  {
    for (int i = 0; i < N; ++i)
      this->items[i] = value;
  }
  bool operator==(const Array<T, N>& other) const
  {
    for (int i = 0; i < N; ++i)
      if (!(this->items[i] == other.items[i]))
        return false;
    return true;
  }
};

// A view of contiguous elements (what std::span converts to): a pointer and a count, over an
// array, a Vector, an Array or a String's characters.
template<typename T>
struct Span
{
  T* items = nullptr;
  int length = 0;

  using iterator = T*;
  using value_type = T;

  Span() {}
  Span(T* items, int length) : items(items), length(length) {}
  Span(T* first, T* last) : items(first), length(int(last - first)) {}
  implicit Span(Vector<RemoveConst<T>>& v) : items(v.data()), length(v.size()) {}
  implicit Span(const Vector<RemoveConst<T>>& v) : items(v.data()), length(v.size()) {}
  template<int N>
  implicit Span(Array<RemoveConst<T>, N>& a) : items(a.data()), length(N) {}
  template<int N>
  implicit Span(const Array<RemoveConst<T>, N>& a) : items(a.data()), length(N) {}
  template<int N>
  implicit Span(T (&a)[N]) : items(a), length(N) {}

  int size() const { return this->length; }
  bool empty() const { return this->length == 0; }
  T& operator[](int index) const { return this->items[index]; }
  T* data() const { return this->items; }
  T* begin() const { return this->items; }
  T* end() const { return this->items + this->length; }
  T& front() const { return this->items[0]; }
  T& back() const { return this->items[this->length - 1]; }
  Span<T> subspan(int offset, int count) const { return Span<T>(this->items + offset, count); }
  Span<T> subspan(int offset) const { return Span<T>(this->items + offset, this->length - offset); }
  Span<T> first(int count) const { return Span<T>(this->items, count); }
  Span<T> last(int count) const { return Span<T>(this->items + this->length - count, count); }
};

// An ordered map (what std::map converts to): entries are Pair<K, V> in key order.
template<typename K, typename V>
struct Map
{
  Vector<Pair<K, V>> entries;

  using iterator = Pair<K, V>*;
  using const_iterator = const Pair<K, V>*;

  int size() const { return this->entries.size(); }
  bool empty() const { return this->entries.empty(); }
  Pair<K, V>* begin() { return this->entries.begin(); }
  Pair<K, V>* end() { return this->entries.end(); }
  const Pair<K, V>* begin() const { return this->entries.begin(); }
  const Pair<K, V>* end() const { return this->entries.end(); }

  // Index of key, or of the place it would take.
  int lowerBoundIndex(const K& key) const
  {
    int low = 0;
    int high = this->entries.size();
    while (low < high)
    {
      int middle = (low + high) / 2;
      if (this->entries.items[middle].first < key)
        low = middle + 1;
      else
        high = middle;
    }
    return low;
  }
  Pair<K, V>* lowerBound(const K& key) { return this->entries.begin() + this->lowerBoundIndex(key); }
  Pair<K, V>* lower_bound(const K& key) { return this->lowerBound(key); }
  bool contains(const K& key) const
  {
    int i = this->lowerBoundIndex(key);
    return i < this->entries.size() && !(key < this->entries.items[i].first);
  }
  int count(const K& key) const { return this->contains(key) ? 1 : 0; }
  // The entry with key, or end().
  Pair<K, V>* find(const K& key)
  {
    int i = this->lowerBoundIndex(key);
    if (i < this->entries.size() && !(key < this->entries.items[i].first))
      return this->entries.begin() + i;
    return this->entries.end();
  }
  const Pair<K, V>* find(const K& key) const
  {
    int i = this->lowerBoundIndex(key);
    if (i < this->entries.size() && !(key < this->entries.items[i].first))
      return this->entries.begin() + i;
    return this->entries.end();
  }
  // The value for key, inserted default-constructed when new.
  V& operator[](const K& key)
  {
    int i = this->lowerBoundIndex(key);
    if (i < this->entries.size() && !(key < this->entries.items[i].first))
      return this->entries.items[i].second;
    this->entries.insert(i, Pair<K, V>(key, V()));
    return this->entries.items[i].second;
  }
  V& at(const K& key) { return this->find(key)->second; }
  const V& at(const K& key) const { return this->find(key)->second; }
  // True when the key was new (an existing value is kept, as std::map::insert keeps it).
  bool insert(const K& key, const V& value)
  {
    int i = this->lowerBoundIndex(key);
    if (i < this->entries.size() && !(key < this->entries.items[i].first))
      return false;
    this->entries.insert(i, Pair<K, V>(key, value));
    return true;
  }
  bool insert(const Pair<K, V>& entry) { return this->insert(entry.first, entry.second); }
  bool erase(const K& key)
  {
    int i = this->lowerBoundIndex(key);
    if (i >= this->entries.size() || key < this->entries.items[i].first)
      return false;
    this->entries.erase(i);
    return true;
  }
  Pair<K, V>* erase(Pair<K, V>* at) { return this->entries.erase(at); }
  void clear() { this->entries.clear(); }
};

template<typename T>
struct Set
{
  Vector<T> values;

  int size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T* begin() { return this->values.begin(); }
  T* end() { return this->values.end(); }

  // Index of value, or of the place it would take.
  int lowerBound(const T& value) const
  {
    int low = 0;
    int high = this->values.size();
    while (low < high)
    {
      int middle = (low + high) / 2;
      if (this->values.items[middle] < value)
        low = middle + 1;
      else
        high = middle;
    }
    return low;
  }
  bool contains(const T& value) const
  {
    int i = this->lowerBound(value);
    return i < this->values.size() && !(value < this->values.items[i]);
  }
  // True when the value was new.
  bool insert(const T& value)
  {
    int i = this->lowerBound(value);
    if (i < this->values.size() && !(value < this->values.items[i]))
      return false;
    this->values.push_back(value);
    for (int k = this->values.size() - 1; k > i; --k)
      this->values.items[k] = this->values.items[k - 1];
    this->values.items[i] = value;
    return true;
  }
  bool erase(const T& value)
  {
    int i = this->lowerBound(value);
    if (i >= this->values.size() || value < this->values.items[i])
      return false;
    this->values.erase(i);
    return true;
  }
  void clear() { this->values.clear(); }
};

template<typename T>
struct Deque
{
  Vector<T> values;
  int head = 0; // index of the first live value

  int size() const { return this->values.size() - this->head; }
  bool empty() const { return this->size() == 0; }
  T& front() { return this->values.items[this->head]; }
  T& back() { return this->values.back(); }
  T& operator[](int index) { return this->values.items[this->head + index]; }
  T* begin() { return this->values.begin() + this->head; }
  T* end() { return this->values.end(); }

  void push_back(const T& value) { this->values.push_back(value); }
  void pop_back() { this->values.pop_back(); }
  void pop_front()
  {
    ++this->head;
    if (this->head > 32 && this->head * 2 > this->values.size())
    {
      // Slide the live values down so that the dead prefix does not grow forever.
      int live = this->values.size() - this->head;
      for (int i = 0; i < live; ++i)
        this->values.items[i] = this->values.items[this->head + i];
      while (this->values.size() > live)
        this->values.pop_back();
      this->head = 0;
    }
  }
  void push_front(const T& value)
  {
    if (this->head > 0)
    {
      --this->head;
      this->values.items[this->head] = value;
      return;
    }
    this->values.push_back(value);
    for (int k = this->values.size() - 1; k > 0; --k)
      this->values.items[k] = this->values.items[k - 1];
    this->values.items[0] = value;
  }
  void clear()
  {
    this->values.clear();
    this->head = 0;
  }
};

// A first-in, first-out queue: push at the back, pop at the front (std::queue over a deque).
template<typename T>
struct Queue
{
  Deque<T> values;

  int size() const { return this->values.size(); }
  bool empty() const { return this->values.empty(); }
  T& front() { return this->values.front(); }
  T& back() { return this->values.back(); }
  void push(const T& value) { this->values.push_back(value); }
  void pop() { this->values.pop_front(); }
  void clear()
  {
    while (!this->values.empty())
      this->values.pop_front();
  }
};
