// Kov standard library: Vector<T>. A growable array; elements are relocated bitwise when the
// buffer grows, which every Kov type is expected to allow.
template<typename T>
struct Vector
{
  T* items = nullptr;
  int length = 0;
  int capacity = 0;

  using iterator = T*;
  using const_iterator = const T*;
  using reverse_iterator = ReverseIterator<T>;
  using const_reverse_iterator = ReverseIterator<const T>;
  using value_type = T;

  Vector() {}
  // count default-constructed elements.
  explicit Vector(int count) { this->resize(count); }
  // `Vector<int> primes = {2, 3, 5, 7};`
  Vector(InitializerList<T> list)
  {
    this->reserve(list.size());
    for (const T& item : list)
      this->push_back(item);
  }
  Vector(const Vector<T>& other)
  {
    this->reserve(other.length);
    for (int i = 0; i < other.length; ++i)
      this->push_back(other.items[i]);
  }
  Vector(Vector<T>&& other) : items(other.items), length(other.length), capacity(other.capacity)
  {
    other.items = nullptr;
    other.length = 0;
    other.capacity = 0;
  }
  ~Vector()
  {
    this->clear();
    if (this->items)
      free(this->items);
  }

  Vector<T>& operator=(const Vector<T>& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    this->reserve(other.length);
    for (int i = 0; i < other.length; ++i)
      this->push_back(other.items[i]);
    return *this;
  }
  Vector<T>& operator=(Vector<T>&& other)
  {
    if (this == &other)
      return *this;
    this->clear();
    if (this->items)
      free(this->items);
    this->items = other.items;
    this->length = other.length;
    this->capacity = other.capacity;
    other.items = nullptr;
    other.length = 0;
    other.capacity = 0;
    return *this;
  }

  int size() const { return this->length; }
  T* data() { return this->items; }
  const T* data() const { return this->items; }
  // A Vector is a Span of its elements (what passing a std::vector to a std::span parameter does).
  operator Span<T>() { return Span<T>(this->items, this->length); }
  operator Span<const T>() const { return Span<const T>(this->items, this->length); }
  bool empty() const { return this->length == 0; }
  T& operator[](int index) { return this->items[index]; }
  T& back() { return this->items[this->length - 1]; }
  T* begin() { return this->items; }
  T* end() { return this->items + this->length; }
  const T* begin() const { return this->items; }
  const T* end() const { return this->items + this->length; }
  const T* cbegin() const { return this->items; }
  const T* cend() const { return this->items + this->length; }
  ReverseIterator<T> rbegin() { return ReverseIterator<T>(this->items + this->length); }
  ReverseIterator<T> rend() { return ReverseIterator<T>(this->items); }
  ReverseIterator<const T> rbegin() const { return ReverseIterator<const T>(this->items + this->length); }
  ReverseIterator<const T> rend() const { return ReverseIterator<const T>(this->items); }
  ReverseIterator<const T> crbegin() const { return ReverseIterator<const T>(this->items + this->length); }
  ReverseIterator<const T> crend() const { return ReverseIterator<const T>(this->items); }

  void reserve(int needed)
  {
    if (needed <= this->capacity)
      return;
    int newCapacity = this->capacity == 0 ? 4 : this->capacity;
    while (newCapacity < needed)
      newCapacity *= 2;
    T* bigger = (T*)malloc(newCapacity * sizeof(T));
    if (this->items)
    {
      memcpy(bigger, this->items, this->length * sizeof(T));
      free(this->items);
    }
    this->items = bigger;
    this->capacity = newCapacity;
  }

  void push_back(const T& value)
  {
    this->reserve(this->length + 1);
    new (this->items + this->length) T(value);
    ++this->length;
  }
  void push_back(T&& value)
  {
    this->reserve(this->length + 1);
    new (this->items + this->length) T(move(value));
    ++this->length;
  }
  void emplace_back(const T& value) { this->push_back(value); }
  // Builds the new element in place from the arguments.
  template<typename... Args>
  T& emplace_back(Args&&... args)
  {
    this->reserve(this->length + 1);
    new (this->items + this->length) T(forward<Args>(args)...);
    ++this->length;
    return this->items[this->length - 1];
  }
  T& front() { return this->items[0]; }
  void resize(int newLength)
  {
    while (this->length > newLength)
      this->pop_back();
    while (this->length < newLength)
      this->push_back(T());
  }
  T& at(int index) { return this->items[index]; }
  const T& at(int index) const { return this->items[index]; }
  // Inserts before the element position points at (begin()/end() and what find functions return).
  T* insert(T* position, const T& value)
  {
    int index = int(position - this->items);
    this->insert(index, value);
    return this->items + index;
  }
  T* insert(T* position, T&& value)
  {
    int index = int(position - this->items);
    this->insert(index, move(value));
    return this->items + index;
  }
  T* insert(T* position, const T* first, const T* last)
  {
    int index = int(position - this->items);
    for (const T* it = first; it != last; ++it)
      this->insert(index++, *it);
    return this->items + index;
  }
  void insert(int index, const T& value)
  {
    this->openSlot(index);
    new (this->items + index) T(value);
  }
  void insert(int index, T&& value)
  {
    this->openSlot(index);
    new (this->items + index) T(move(value));
  }
  // Makes room for one element at index: the elements from there on move up one place (bitwise,
  // as the buffer growth does).
  void openSlot(int index)
  {
    this->reserve(this->length + 1);
    memmove(this->items + index + 1, this->items + index, (this->length - index) * sizeof(T));
    ++this->length;
  }
  bool contains(const T& value) const
  {
    for (int i = 0; i < this->length; ++i)
      if (this->items[i] == value)
        return true;
    return false;
  }
  void pop_back()
  {
    --this->length;
    this->items[this->length].~T();
  }
  void clear()
  {
    for (int i = 0; i < this->length; ++i)
      this->items[i].~T();
    this->length = 0;
  }
  void erase(int index)
  {
    this->items[index].~T();
    memmove(this->items + index, this->items + index + 1, (this->length - index - 1) * sizeof(T));
    --this->length;
  }
  // Removes [first, last), given as pointers into the vector (begin()/end() and what find functions
  // return); returns the position of the element after the removed ones.
  T* erase(T* first, T* last)
  {
    int index = int(first - this->items), count = int(last - first);
    for (int i = 0; i < count; ++i)
      this->items[index + i].~T();
    memmove(this->items + index, this->items + index + count, (this->length - index - count) * sizeof(T));
    this->length -= count;
    return this->items + index;
  }
  T* erase(T* at) { return this->erase(at, at + 1); }
};
