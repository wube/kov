static bool unicodeSearchMapSorted = false;

Span<const Pair<wchar_t, wchar_t>> StringUtil::getUnicodeSearchMap()
{
  if (!unicodeSearchMapSorted)
  {
    sort(unicodeSearchMapData, unicodeSearchMapData + 344,
         [](const Pair<wchar_t, wchar_t>& a, const Pair<wchar_t, wchar_t>& b) { return a.first < b.first; });
    unicodeSearchMapSorted = true;
  }
  return Span<const Pair<wchar_t, wchar_t>>(unicodeSearchMapData, 344);
}
