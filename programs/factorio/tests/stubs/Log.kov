// Stand-in for the game's Logging for the Util smoke test: the converter turns LOG_AND_ABORT and
// LOG_ENUM_AND_ABORT into Logging::logAndAbortOrThrow(__FILE__, __LINE__, LogLevel::Error, ...)
// (LogLevel is the converted Util/LogLevel.kov); here it prints the message and ends the program.
extern "C" void abort();
class Logging
{
public:
  static void logAndAbortOrThrow(const char* file, uint32_t line, LogLevel level, const char* format, ...)
  {
    println("abort at {}:{}: {}", file, line, format);
    abort();
  }
  static void logAndAbortOrThrow(const char* file, uint32_t line, LogLevel level, const String& message)
  {
    println("abort at {}:{}: {}", file, line, message);
    abort();
  }
  template<typename EnumType>
  static void logEnumAndAbortOrThrow(const char* file, uint32_t line, LogLevel level, EnumType value)
  {
    println("abort at {}:{}: unknown enum value {}", file, line, int(value));
    abort();
  }
};
