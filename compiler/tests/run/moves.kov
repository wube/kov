// Copies and moves follow C++: an lvalue is copied, a temporary or move(x) is moved, a `T&&`
// overload takes only rvalues, forwarding keeps the value category, and a class without copy or
// move constructors copies or moves its members one by one.
extern "C" int printf(const char* format, ...);

int copies = 0;
int moves = 0;
int copyAssigns = 0;
int moveAssigns = 0;

struct Tracker
{
  int id;
  bool movedFrom = false;
  Tracker(int id) : id(id) {}
  Tracker(const Tracker& other) : id(other.id) { ++copies; }
  Tracker(Tracker&& other) : id(other.id)
  {
    other.movedFrom = true;
    ++moves;
  }
  Tracker& operator=(const Tracker& other)
  {
    this->id = other.id;
    ++copyAssigns;
    return *this;
  }
  Tracker& operator=(Tracker&& other)
  {
    this->id = other.id;
    other.movedFrom = true;
    ++moveAssigns;
    return *this;
  }
};

void byValue(Tracker t) {}
const char* byRef(const Tracker& t) { return "ref"; }
const char* byRef(Tracker&& t) { return "rvalue"; }

// No copy or move constructor of its own: members are copied or moved one by one.
struct Holder
{
  Tracker t;
  UniquePtr<int> p;
  Holder(int id) : t(id), p(new int(id)) {}
};

int main()
{
  Tracker a(1);
  Tracker b = a;       // copy
  Tracker c = move(a); // move
  byValue(b);          // copy
  byValue(move(b));    // move
  byValue(Tracker(5)); // a temporary: no constructor call at all
  printf("%d %d %d\n", copies, moves, a.movedFrom ? 1 : 0);
  printf("%s %s %s\n", byRef(c), byRef(move(c)), byRef(Tracker(6)));
  Vector<Tracker> v;
  v.push_back(c);             // copy
  v.push_back(move(c));       // move
  v.emplace_back(c);          // copy: forwarding an lvalue
  v.emplace_back(Tracker(7)); // move: forwarding a temporary
  printf("%d %d %d\n", copies, moves, v.size());
  c = b;
  c = move(b);
  printf("%d %d\n", copyAssigns, moveAssigns);
  Holder h(8);
  Holder h2 = move(h); // memberwise: the Tracker and the UniquePtr are moved
  printf("%d %d %d %d\n", moves, h.t.movedFrom ? 1 : 0, h.p ? 1 : 0, *h2.p);
  Vector<UniquePtr<int>> owners;
  UniquePtr<int> u(new int(9));
  owners.push_back(move(u));
  owners.emplace_back(new int(10));
  printf("%d %d %d\n", u ? 1 : 0, *owners[0], *owners[1]);
  swap(owners[0], owners[1]);
  printf("%d %d\n", *owners[0], *owners[1]);
  String s = "text";
  String t = move(s);
  printf("%d %s\n", s.size(), t.c_str());
  return 0;
}
