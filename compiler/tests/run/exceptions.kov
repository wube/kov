// Exceptions: throw and catch by reference, by value and by base class, catch-all, rethrow,
// nested handlers, destructors of locals and temporaries run while unwinding, throwing out of
// a handler, return and break out of a handler, exceptions crossing several frames.
extern "C" int printf(const char* format, ...);

static int live = 0;

struct Tracker
{
  int id;
  Tracker(int id) : id(id) { live += 1; }
  ~Tracker()
  {
    live -= 1;
    printf("~Tracker(%d)\n", this->id);
  }
};

struct Error : Exception
{
  int code;
  Error(const String& message, int code) : Exception(message), code(code) {}
};

struct Other
{
  int value;
  Other(int value) : value(value) {}
};

int depth3(int x)
{
  Tracker t(3);
  if (x > 0)
    throw Error("deep", x);
  return x;
}

int depth2(int x)
{
  Tracker t(2);
  return depth3(x) + 1;
}

int depth1(int x)
{
  Tracker t(1);
  int r = depth2(x);
  printf("depth1 done %d\n", r);
  return r;
}

String describe(int x)
{
  try
  {
    String prefix = "value ";
    prefix += (char)(depth1(x) + 48);
    return prefix;
  }
  catch (const Error& e)
  {
    return String("error: ") + e.what();
  }
}

int fromHandler(int x)
{
  for (int i = 0; i < 3; ++i)
  {
    Tracker loop(10 + i);
    try
    {
      if (i == x)
        throw Other(i);
      printf("iteration %d\n", i);
    }
    catch (Other o)
    {
      printf("caught Other %d\n", o.value);
      if (o.value == 1)
        break;
      return o.value * 100;
    }
  }
  return -1;
}

void rethrower()
{
  try
  {
    throw Error("original", 7);
  }
  catch (Exception& e)
  {
    printf("rethrowing %s\n", e.what());
    throw;
  }
}

void translator()
{
  try
  {
    Tracker t(20);
    rethrower();
  }
  catch (const Error& e)
  {
    printf("translating %s (%d)\n", e.what(), e.code);
    throw RuntimeError(String("wrapped ") + e.what());
  }
}

int main()
{
  // Nothing thrown: no handler runs.
  printf("%s\n", describe(0).c_str());
  printf("live %d\n", live);
  // Thrown three frames down: destructors run in order, the handler sees the message.
  printf("%s\n", describe(5).c_str());
  printf("live %d\n", live);
  // Catch by value, leaving the handler with return and break.
  printf("fromHandler %d\n", fromHandler(2));
  printf("fromHandler %d\n", fromHandler(1));
  printf("live %d\n", live);
  // Rethrow and translation through nested handlers, catch-all at the end.
  try
  {
    translator();
  }
  catch (const Error&)
  {
    printf("wrong handler\n");
  }
  catch (const RuntimeError& e)
  {
    printf("outer caught %s\n", e.what());
  }
  catch (...)
  {
    printf("catch-all\n");
  }
  // Non-class exceptions and the catch-all.
  try
  {
    throw 42;
  }
  catch (const char* s)
  {
    printf("string %s\n", s);
  }
  catch (int n)
  {
    printf("int %d\n", n);
  }
  try
  {
    throw "text";
  }
  catch (int n)
  {
    printf("int %d\n", n);
  }
  catch (...)
  {
    printf("catch-all\n");
  }
  // A temporary alive during the call is destroyed while unwinding.
  try
  {
    printf("%d\n", depth3(Tracker(30).id));
  }
  catch (const Exception& e)
  {
    printf("caught %s, live %d\n", e.what(), live);
  }
  printf("live %d\n", live);
  return 0;
}
