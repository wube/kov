// spec: Variant (std::variant)
// factorio: 24 uses in 15 files (Kov's answer is the typed union, design.md 8.5)
// pending: by decision there is no Variant class: a std::variant becomes a typed union (`union enum`, design.md 8.5); what is missing is the converter's mapping of the 24 uses
int main()
{
  Variant<int, String> v = 5;
  v = String("text");
  println("{} {}", holdsAlternative<String>(v), get<String>(v));
  return 0;
}
