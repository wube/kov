// spec: Pair (std::pair) and makePair; Tuple
// factorio: 354 pair uses in 199 files, 51 tuple
// pending: Tuple with get<N> is not in the library yet
int main()
{
  Pair<String, int> p = makePair(String("a"), 1);
  Pair<int, int> q(2, 3);
  Tuple<int, String, double> t = makeTuple(1, String("two"), 3.0);
  println("{} {} {} {} {}", p.first, p.second + q.first * q.second, get<0>(t), get<1>(t), q < Pair<int, int>(2, 4));
  return 0;
}
