// spec: Limits (numeric_limits) and math functions (abs, sqrt, floor, ceil, round, pow, isnan)
// factorio: 631 numeric_limits uses in 279 files
extern "C" int printf(const char* format, ...);
int main()
{
  printf("%d %d %u %lld\n", Limits<int>::max(), Limits<int>::min(), Limits<unsigned>::max(), Limits<long long>::max());
  printf("%d %.1f %.1f %.1f %.1f %.1f %d %d\n", ::abs(-3), ::abs(-2.5), ::sqrt(16.0), ::floor(2.7), ::ceil(2.1), ::pow(2.0, 10.0), ::isnan(0.0 / 0.0), ::isinf(1.0 / 0.0));
  return 0;
}
