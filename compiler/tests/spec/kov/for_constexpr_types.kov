// spec: for constexpr over a list of types
// design.md 8.1 and 8.2
struct A { static const char* name() { return "a"; } };
struct B { static const char* name() { return "b"; } };
int main()
{
  String names;
  for constexpr (typename T : types<A, B>)
    names += T::name();
  println("{}", names);
  return 0;
}
