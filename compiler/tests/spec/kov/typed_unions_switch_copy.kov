// spec: typed unions: switch on the union, methods, copying and assignment carry the alternative, destruction follows the tag
// design.md 8.5
struct Tracked
{
  int id;
  Tracked(int id) : id(id) {}
  Tracked(const Tracked& other) : id(other.id) {}
  ~Tracked() { println("~{}", this->id); }
};
union enum Value : uint8_t
{
  { {int, Number}, {String, Text}, {Tracked, Owned} }
  String describe() const
  {
    switch (*this)
    {
      case Number: return format("number {}", (*this)[Number]);
      case Text: return format("text {}", (*this)[Text]);
      case Owned: return format("owned {}", (*this)[Owned].id);
    }
  }
};
int main()
{
  Tracked t(7);
  Value a;
  a[Value::Text] = String("hello");
  Value b = a;
  a[Value::Owned] = t;
  println("{} | {} | {}", a.describe(), b.describe(), a != Value::Text);
  b = a;
  println("{}", b.describe());
  a[Value::Number] = 1;
  println("{}", a.describe());
  return 0;
}
