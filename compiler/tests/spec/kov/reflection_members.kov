// spec: members(T) with m.name, m.type and object.[m]
// design.md 8.3; replaces the serialisation and GUI macros
struct Settings { int width = 640; bool fullscreen = false; };
template<typename T>
String describe(const T& object)
{
  String result;
  for constexpr (auto m : members(T))
    result += format("{}={} ", m.name, object.[m]);
  return result;
}
int main()
{
  println("{}", describe(Settings()));
  return 0;
}
