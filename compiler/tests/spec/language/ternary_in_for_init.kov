// SPEC: a ternary ?: inside a classic for-init must not be parsed as a range-for
// STATUS: pass

extern "C" import "stdio.h";

int main()
{
  int sum = 0;
  bool odd = true;
  for (int i = odd ? 1 : 0; i < 10; i += 2)
    sum += i;
  printf("%d\n", sum);
  // expected: 25 (1+3+5+7+9)
  return 0;
}
// EXPECT: 25
