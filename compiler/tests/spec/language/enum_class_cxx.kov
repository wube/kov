// spec: C++-style enum class with underlying type, casts, flags with operators
// factorio: 961 uses in 701 files
enum class Color : uint8_t { Red, Green = 5, Blue };
enum class Mask : unsigned { None = 0, A = 1, B = 2, C = 4 };
Mask operator|(Mask a, Mask b) { return Mask(unsigned(a) | unsigned(b)); }
bool has(Mask m, Mask flag) { return (unsigned(m) & unsigned(flag)) != 0; }
const char* name(Color c)
{
  switch (c)
  {
    case Color::Red: return "red";
    case Color::Green: return "green";
    case Color::Blue: return "blue";
  }
  return "?";
}
int main()
{
  Color c = Color::Blue;
  Mask m = Mask::A | Mask::C;
  println("{} {} {} {} {} {}", name(c), int(c), (int)sizeof(Color), has(m, Mask::C), has(m, Mask::B), c == Color::Blue);
  return 0;
}
