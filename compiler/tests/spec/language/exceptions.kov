// spec: exceptions: throw, catch by reference and base, rethrow, cleanup of locals
// factorio: 3118 throw sites in 853 files, 457 try blocks
struct Note { const char* text; Note(const char* t) : text(t) {} ~Note() { println("~{}", this->text); } };
struct Failure : Exception { int code; Failure(int code) : Exception(String("failed")), code(code) {} };
int risky(int n)
{
  Note note("local");
  if (n > 2)
    throw Failure(n);
  return n;
}
int main()
{
  try
  {
    risky(1);
    risky(3);
    println("not reached");
  }
  catch (const Exception& e)
  {
    println("caught {}", e.what());
  }
  try
  {
    try { throw RuntimeError(String("inner")); }
    catch (const RuntimeError&) { println("rethrowing"); throw; }
  }
  catch (const Exception& e) { println("outer {}", e.what()); }
  return 0;
}
