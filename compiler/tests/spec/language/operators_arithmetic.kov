// spec: arithmetic, bit and compound operators
int main()
{
  int a = 7, b = 2;
  a += 3; a -= 1; a *= 2; a /= 3; a %= 5;   // 7+3=10, 9, 18, 6, 1
  int c = (a << 4) | 3;                       // 19
  c ^= 0xF;                                   // 28
  c &= ~4;                                    // 24
  unsigned u = 1u << 31;
  int pre = ++b, post = b++;                  // 3, 3; b == 4
  int neg = -a, inv = !a ? 1 : 0;
  long long big = 1ll << 40;
  println("{} {} {} {} {} {} {} {} {}", a, c, u >> 31, pre, post, b, neg, inv, big / (1ll << 30));
  println("{} {} {}", 7 / 2, -7 / 2, -7 % 3);
  println("{} {}", 7.0 / 2, 1e3 == 1000.0);
  return 0;
}
