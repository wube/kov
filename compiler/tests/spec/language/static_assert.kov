// spec: static_assert
// factorio: 470 uses in 237 files
struct Header { int32_t size; int32_t kind; };
static_assert(sizeof(Header) == 8, "header is two words");
static_assert(isSame<int, int32_t>, "int is 32 bits here");
template<typename T>
struct Checked
{
  static_assert(sizeof(T) <= 8, "fits a register");
  T value;
};
int main()
{
  Checked<int> c{5};
  println("{}", c.value);
  return 0;
}
