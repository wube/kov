// spec: an operator function called by name: `operator==(a, b)`, `a.operator[](i)`
// found in src/Util (SHA1)
struct Digest { int a; int b; };
bool operator==(const Digest& l, const Digest& r) { return l.a == r.a && l.b == r.b; }
bool differ(const Digest& l, const Digest& r) { return !operator==(l, r); }
int main()
{
  Digest x{1, 2};
  Digest y{1, 3};
  Vector<int> v;
  v.push_back(7);
  println("{} {} {}", differ(x, y), differ(x, x), v.operator[](0));
  return 0;
}
