// spec: copying and moving objects with owned resources, assignment, self-contained counts
struct Tracker
{
  static int copies;
  static int moves;
  Vector<int> data;
  Tracker() {}
  Tracker(const Tracker& o) : data(o.data) { ++Tracker::copies; }
  Tracker(Tracker&& o) : data(::move(o.data)) { ++Tracker::moves; }
  Tracker& operator=(const Tracker& o) { this->data = o.data; ++Tracker::copies; return *this; }
  Tracker& operator=(Tracker&& o) { this->data = ::move(o.data); ++Tracker::moves; return *this; }
};
int Tracker::copies = 0;
int Tracker::moves = 0;
Tracker make() { Tracker t; t.data.push_back(1); return t; }
void byValue(Tracker t) { t.data.push_back(2); }
int main()
{
  Tracker a = make();
  Tracker b = a;
  byValue(a);
  byValue(::move(b));
  Vector<Tracker> v;
  v.push_back(::move(a));
  println("{} {} {} {}", Tracker::copies, Tracker::moves >= 2, v[0].data.size(), a.data.size());
  return 0;
}
