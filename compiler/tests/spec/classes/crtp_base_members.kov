// spec: members of a base instantiated with the derived class itself (`struct Vec : Vector2<double, Vec>`) have the instantiation's types wherever the derived object is used
// found in src/Util (Vector2D, Vector2f and the positions derive from Vector2<T, V>; `movement.x` on a const Vector2D& was typed T)
template<typename T, typename V>
struct Vector2
{
  T x = 0, y = 0;
  constexpr Vector2() = default;
  constexpr Vector2(T x, T y) : x(x), y(y) {}
  V scaled(T k) const { return V(this->x * k, this->y * k); }
  T dot(const V& other) const { return this->x * other.x + this->y * other.y; }
};
struct Vec : Vector2<double, Vec>
{
  constexpr Vec() = default;
  constexpr Vec(double x, double y) : Vector2(x, y) {}
  Vec flipped() const { return Vec(-this->x, this->y); }
};
double sum(const Vec& v) { return v.x + v.y; }
int main()
{
  Vec v(1.5, 2.0);
  Vec w = v.scaled(2);
  println("{} {} {} {} {}", w.x, w.y, v.flipped().x, v.dot(w), sum(w));
  return 0;
}
