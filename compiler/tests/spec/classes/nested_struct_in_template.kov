// spec: a struct nested in a class template, with members of the parameter type
template<typename T>
struct Holder
{
  struct Node { T value; Node* next = nullptr; };
  Node head;
};
int main()
{
  Holder<int> h;
  h.head.value = 9;
  Holder<int>::Node* n = &h.head;
  println("{} {}", n->value, n->next == nullptr);
  return 0;
}
