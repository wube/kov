// spec: an alias template of a class template (template<typename T> using Ptr = UniquePtr<T>;) used as a variable type
// factorio: 7 alias templates in 6 files
template<typename T> using Ptr = UniquePtr<T>;
struct Big { int v = 2; };
int main()
{
  Ptr<Big> p = makeUnique<Big>();
  println("{}", p->v);
  return 0;
}
