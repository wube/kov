// spec: a static data member of a class template is one object per instantiation
template<typename T>
struct Counted
{
  static int instances;
  Counted() { ++Counted<T>::instances; }
};
template<typename T> int Counted<T>::instances = 0;
int main()
{
  Counted<int> a, b;
  Counted<String> c;
  println("{} {}", Counted<int>::instances, Counted<String>::instances);
  return 0;
}
