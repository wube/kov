// spec: dependent names: T::Type, T::constant, this-> in templates, a dependent return type
struct Meters { using Unit = int; static const int scale = 100; Unit value = 3; };
template<typename T>
struct Stack
{
  Vector<T> items;
  void add(const T& t) { this->items.push_back(t); }
  int size() const { return this->items.size(); }
};
template<typename T> typename T::Unit scaled(const T& t) { return t.value * T::scale; }
int main()
{
  Stack<String> names;
  names.add(String("a"));
  names.add(String("bc"));
  Meters m;
  int s = scaled(m);
  println("{} {} {}", names.size(), names.items[1], s);
  return 0;
}
