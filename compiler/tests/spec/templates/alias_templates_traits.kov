// spec: type traits in if constexpr (isPointer, isSame) inside a deduced function template
// factorio: 169 type trait uses in 77 files
struct Big { int v = 2; };
template<typename T> const char* describe(const T&) { if constexpr (isPointer<T>) return "pointer"; else if constexpr (isSame<T, Big>) return "big"; else return "value"; }
int main()
{
  Big b;
  println("{}", describe(&b));
  println("{}", describe(b));
  println("{}", describe(1));
  return 0;
}
