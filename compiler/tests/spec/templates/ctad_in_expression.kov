// spec: class template argument deduction in an expression, not only a declaration: `Pair(a, b)` as a call argument, `Span(p, n)` in a return
// found in src/Util (MathExpressions/Tokenizer: `second.find(Pair(firstChar, nextChar))`, Evaluator: Span of the last arguments)
int sumPair(const Pair<int, int>& p) { return p.first + p.second; }
Span<int> tail(Vector<int>& v, int n) { return Span(v.end() - n, n); }
int main()
{
  Vector<int> v;
  v.push_back(1);
  v.push_back(2);
  v.push_back(3);
  Span<int> last = tail(v, 2);
  println("{} {} {}", sumPair(Pair(3, 4)), last.size(), last[1]);
  return 0;
}
