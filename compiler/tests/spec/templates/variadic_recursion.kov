// spec: the recursive variadic pattern: f(T first, Rest... rest) calling f(rest...) down to a non-template base case
// pending: the recursive call's template arguments are not deduced inside the instantiation
int sum() { return 0; }
template<typename T, typename... Rest> int sum(T first, Rest... rest) { return first + sum(rest...); }
int main()
{
  println("{} {}", sum(1, 2, 3, 4), sum(5));
  return 0;
}
