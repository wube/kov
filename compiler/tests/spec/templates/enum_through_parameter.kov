// spec: a Kov enum reached through a template parameter: E::values, E::count, value.str()
enum class Dir : uint8_t
{
  { A, B, C }
};
template<typename E> String joined()
{
  String all;
  for (E v : E::values)
    all += v.str();
  return all;
}
template<typename E> int countOf() { return E::count; }
int main()
{
  println("{} {}", joined<Dir>(), countOf<Dir>());
  return 0;
}
