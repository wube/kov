// spec: importing SDL3's header (the game's platform layer) and using its types and constants without linking it
// the suite passes --cinclude C:\Factorio\libraries\SDL3\include when that checkout exists; nothing of SDL is called, so no SDL3.lib
extern "C" import "SDL3/SDL.h";
int main()
{
  SDL_Rect r{0, 0, 640, 480};
  println("{} {}", r.w, SDL_INIT_VIDEO != 0);
  return 0;
}
